# Sample worker.env — see docs/cli/index.md#workerenv for the full walkthrough.
# The worker only needs Manager and Redis connectivity - no Registry, MongoDB,
# or Syncer config required. Replace 192.168.1.100 with the manager's IP.

# Nebula Manager
MANAGER_HOST=192.168.1.100
MANAGER_PORT=80

# Nebula credentials
NEBULA_USERNAME=nebula
NEBULA_PASSWORD=nebula
NEBULA_AUTH_TOKEN=bmVidWxhOm5lYnVsYQ==
NEBULA_PROTOCOL=http

# Redis (for metric reporting)
REDIS_HOST=192.168.1.100
REDIS_PORT=6379
REDIS_AUTH_TOKEN=your-redis-token
REDIS_KEY_PREFIX=gustavo-reports
CACHE_EXPIRE_TIME=120

# Worker container network mode
WORKER_NMODE=host
